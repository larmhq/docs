{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Larm",
  "colors": {
    "primary": "#E85545",
    "light": "#F06B5D",
    "dark": "#C94438"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
