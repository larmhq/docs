        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/introduction"]
          },
          {
            "group": "Endpoints",
            "pages": ["api-reference/heartbeat"]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Status",
        "href": "https://larm.status.larm.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.larm.dev"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "footer": {
